# ── WordPress Backend ──────────────────────────────────────────────────────────
# Full URL to your WPGraphQL endpoint.
# In WordPress admin: Settings → Permalinks → Save (activates pretty permalinks)
# Then install WPGraphQL plugin — the endpoint appears at /graphql
WORDPRESS_API_URL=https://your-site.com/graphql

# ── On-Demand Revalidation ─────────────────────────────────────────────────────
# Secret token used to authenticate revalidation requests from WordPress.
# Generate with: openssl rand -hex 32
# In WordPress: use WPGraphQL Webhooks plugin or a custom plugin/function
# to POST { "secret": "<this value>", "path": "/blog/the-post-slug" }
# to https://your-vercel-deployment.vercel.app/api/revalidate
REVALIDATE_SECRET=replace_with_random_secret_string
